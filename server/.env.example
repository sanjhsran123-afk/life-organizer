# Environment Mode ('production' or 'development')
NODE_ENV=production

# Server Port (Render provides this automatically; local default is 5000)
PORT=5000

# MongoDB Connection String (from MongoDB Atlas)
# Note: Configure Atlas Network Access to allow only your hosting provider's approved outbound IPs or private networking. Never use 0.0.0.0/0.
MONGODB_URI=

# JSON Web Token Secret (generate a strong random secret key for session tokens)
JWT_SECRET=

# Admin User Emails (comma-separated list of emails granted administrative privileges)
ADMIN_EMAILS=

# Production Allowed Frontend Website Origin(s) for CORS (comma-separated, e.g. https://<project>.pages.dev, https://your-site.netlify.app)
CLIENT_URL=

# Optional: Configurable Mobile App Origins for Android/iOS builds (comma-separated, e.g. https://localhost, capacitor://localhost, ionic://localhost)
APP_ORIGINS=
