# Environment Mode ('production' or 'development')
NODE_ENV=production

# Server Port (Render provides this automatically; local default is 5000)
PORT=5000

# MongoDB Connection String (from MongoDB Atlas)
# Note: Configure Atlas Network Access to allow only your hosting provider's approved outbound IPs or private networking. Never use 0.0.0.0/0.
MONGODB_URI=

# JSON Web Token Secret (generate a strong random secret key for session tokens)
JWT_SECRET=

# Admin User Emails (comma-separated list of emails granted administrative privileges)
ADMIN_EMAILS=

# Production Allowed Frontend Website Origin(s) for CORS (comma-separated, e.g. https://<project>.pages.dev, https://your-site.netlify.app)
CLIENT_URL=

# Optional: Configurable Mobile App Origins for Android/iOS builds (comma-separated, e.g. https://localhost, capacitor://localhost, ionic://localhost)
APP_ORIGINS=

# Web Push VAPID Keys for PWA Push Notifications (Configure in Render Environment Variables)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@dayledger.app

# ==================== SMS PROVIDER CONFIGURATION ====================
# Phone verification strictly requires a configured SMS provider to deliver OTPs.
# If no provider is configured, phone verification is disabled and users remain undiscoverable.

# Option 1: Twilio (Recommended for production transactional SMS)
# Get credentials from https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional: Use Messaging Service SID instead of phone number
TWILIO_MESSAGING_SERVICE_SID=

# Option 2: Generic SMS Gateway / Webhook
# SMS_GATEWAY_URL=https://api.sms-provider.com/v1/send
# SMS_GATEWAY_API_KEY=your_sms_gateway_api_key

# Optional: Default country code for 10-digit phone numbers (default is +91)
DEFAULT_COUNTRY_CODE=+91

# ==================== CLOUDFLARE R2 PRIVATE FILE STORAGE ====================
# Required for private document, PDF, and image sharing between accepted friends.
# If omitted, file sharing is disabled and file contents are never stored in MongoDB or public folders.
# Obtain from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens (Permissions: Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dayledger-private-files

# ==================== WEBRTC AUDIO CALLS (STUN / TURN) ====================
# Default public Google STUN servers (stun:stun.l.google.com:19302) are always used automatically.
# For high-reliability NAT/firewall traversal behind symmetric cellular networks, configure TURN:
# Note: To protect against credential abuse, DayLedger uses ephemeral, short-lived per-session credentials (RFC 5766 REST API).
# Permanent shared credentials (TURN_USERNAME/TURN_CREDENTIAL) are NOT exposed to clients.
# Configure your Coturn / Metered / Twilio shared secret:
TURN_URL=
TURN_SECRET=

# ==================== FIREBASE CLOUD MESSAGING (FCM) ====================
# Required for high-priority native Android background calling and lock-screen rings.
# Primary (Recommended for Render): Render Secret File
# 1. In Render Dashboard -> Environment -> Secret Files -> Add Secret File:
#    - Filename: firebase-service-account.json
#    - File Contents: (paste the entire downloaded service account JSON from Firebase Console)
# 2. In Render Dashboard -> Environment Variables:
#    GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json
#
# Safe fallback options:
# FIREBASE_SERVICE_ACCOUNT_PATH=/etc/secrets/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=




