# Frontend Environment Configuration for Vite, Cloudflare Pages & Netlify
# Add this environment variable in your Cloudflare Pages / Netlify Project Settings:
# Cloudflare Pages: Settings > Environment variables > Add variable (Production & Preview)
# Netlify: Site configuration > Environment variables > Add a variable
VITE_API_URL=https://life-organizer-gmpc.onrender.com

# Google Maps Embed API Key (Unlimited Free Usage / $0 SKU)
# Enable "Maps Embed API" in Google Cloud Console: https://console.cloud.google.com/google/maps-apis/credentials
# Note: Google requires a linked billing account on the GCP project to activate any Maps API, even though Embed API has $0 usage charges.
# Restrict this key under Application Restrictions > Websites (HTTP referrers):
# - https://<your-project>.pages.dev/* (for Cloudflare Pages website)
# - https://your-domain.netlify.app/* (for Netlify fallback website)
# - https://localhost/* (for Capacitor Android app and local development)
# Under API Restrictions, restrict solely to: "Maps Embed API"
VITE_GOOGLE_MAPS_EMBED_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
